{
  "name": "duckbook",
  "private": true,
  "version": "0.1.2",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Thander-cute",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thander-cute/duckbook.git"
  },
  "bugs": {
    "url": "https://github.com/Thander-cute/duckbook/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p . && tsc -p tsconfig.server.json && tsc -p tsconfig.desktop.json",
    "start": "node server/main.ts",
    "test": "node --test \"test/*.test.ts\"",
    "test:browser": "node test/browser.e2e.ts",
    "test:upgrade": "node test/upgrade.e2e.ts",
    "test:sync": "node test/sync.e2e.ts",
    "site:build": "node site/build.ts",
    "test:site": "node test/site.e2e.ts",
    "desktop:bundle": "node desktop/build.ts",
    "desktop:dev": "npm run build && npm run desktop:bundle && electron .",
    "desktop:build": "npm run build && npm run desktop:bundle && electron-builder --win nsis --x64 --publish never",
    "desktop:pack": "npm run build && npm run desktop:bundle && electron-builder --win --x64 --dir",
    "desktop:test": "node test/desktop.e2e.ts"
  },
  "dependencies": {
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "electron-updater": "6.8.11",
    "immer": "^11.1.21",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "43.8.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "puppeteer-core": "^25.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "main": "desktop-dist/main.js",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
